# Copy to .env in your repository (DO NOT commit .env).
# These are placeholders/defaults. Adjust to REAL paths on the Linux GPU server.
KITTI_ROOT=data/KITTIDataset
MONODETR_CHECKPOINT=checkpoints/monodetr_pretrained.pth
PSEUDOLABEL_ROOT=data/pseudo_labels/gpro3d
CAMERA_HEIGHT_M=1.65

# Weights & Biases. If you do not want to connect online yet, use offline.
WANDB_PROJECT=monodetr-gpro3d-e1
WANDB_ENTITY=
WANDB_MODE=offline
# To enable ONLINE sync, set WANDB_MODE=online and WANDB_API_KEY privately.
WANDB_API_KEY=

# Existing localhost dashboard. Leave optional token blank if no auth.
DASHBOARD_API_URL=http://127.0.0.1:8000
DASHBOARD_AUTH_TOKEN=
DASHBOARD_BACKEND_PORT=8000
DASHBOARD_FRONTEND_PORT=3000
