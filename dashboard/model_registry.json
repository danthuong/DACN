{
  "models": [
    {
      "id": "monodetr",
      "label": "Baseline MonoDETR",
      "color": "#ff9f43",
      "format": "kitti",
      "prediction_dir": "outputs/monodetr/outputs/data",
      "inference": {
        "builder": "monodetr",
        "config": "configs/monodetr.yaml",
        "default_weight": "best",
        "weights": [
          {"id": "best", "label": "baseline best", "path": "outputs/monodetr/checkpoint_best_1.pth"},
          {"id": "best_alt", "label": "baseline best (alt)", "path": "outputs/monodetr/checkpoint_best.pth"}
