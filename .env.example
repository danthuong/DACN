# Copy to .env. Never commit .env or WANDB_API_KEY.
KITTI_ROOT=data/KITTIDataset
MONODETR_CHECKPOINT=outputs/monodetr/checkpoint_best_1.pth
PSEUDOLABEL_ROOT=outputs/geometry_pseudo_labels
CAMERA_HEIGHT_M=1.65

# W&B is opt-in. Use offline until `wandb login` or WANDB_API_KEY is set.
WANDB_PROJECT=monodetr-gpro3d-e1
WANDB_ENTITY=
WANDB_MODE=offline
WANDB_API_KEY=
WANDB_RUN_ID=

DASHBOARD_API_URL=http://127.0.0.1:8765
DASHBOARD_AUTH_TOKEN=
DASHBOARD_BACKEND_PORT=8765
